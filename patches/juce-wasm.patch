index 0000000..2ba82d5
--- /dev/null
+++ b/juce_events/native/juce_Messaging_wasm.cpp
@@ -0,0 +1,72 @@
+/*
+  ==============================================================================
+
+   WebAssembly (MicFX web): the message queue on the one thread there is. Nothing runs by
+   itself: the page calls juce::wasmDispatchMessages() (exported by the app) from its own
+   event loop, which delivers the posted messages and calls the timers that are due.
+
+  ==============================================================================
+*/
+
+namespace juce
+{
+
+void wasmPumpTimers();
+
+namespace
+{
+    std::deque<MessageManager::MessageBase::Ptr>& wasmQueue()
+    {
+        static std::deque<MessageManager::MessageBase::Ptr> queue;
+        return queue;
+    }
+}
+
+void MessageManager::doPlatformSpecificInitialisation() {}
+
+void MessageManager::doPlatformSpecificShutdown()
+{
+    wasmQueue().clear();
+}
+
+bool MessageManager::postMessageToSystemQueue (MessageManager::MessageBase* const message)
+{
+    wasmQueue().push_back (message);
+    return true;
+}
+
+void MessageManager::broadcastMessage (const String&) {}
+
+namespace detail
+{
+bool dispatchNextMessageOnSystemQueue (bool)
+{
+    auto& queue = wasmQueue();
+    if (queue.empty())
+        return false;
+
+    const auto message = queue.front();
+    queue.pop_front();
+
+    JUCE_TRY
+    {
+        message->messageCallback();
+    }
+    JUCE_CATCH_EXCEPTION
+
+    return true;
+}
+} // namespace detail
+
+/** Delivers what was posted (at most `maxMessages`, so a message that posts another can't
+    hang the page) and calls the timers that are due. Returns how many are still waiting. */
+int wasmDispatchMessages (int maxMessages)
+{
+    wasmPumpTimers();
+
+    for (int i = 0; i < maxMessages && detail::dispatchNextMessageOnSystemQueue (true); ++i) {}
+
+    return (int) wasmQueue().size();
+}
+
+} // namespace juce
