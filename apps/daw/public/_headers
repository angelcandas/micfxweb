# Cloudflare Pages headers. The DAW engine runs on threads (SharedArrayBuffer), which needs
# cross-origin isolation on every page.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# The hand-off page talks to MicFX Voice's window, which isolation would cut off (Pages
# serves handoff.html as /handoff).
/handoff.html
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy
/handoff
  ! Cross-Origin-Opener-Policy
  ! Cross-Origin-Embedder-Policy

# Vite's assets have content hashes, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
