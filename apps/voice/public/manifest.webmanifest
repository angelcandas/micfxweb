{
  "name": "MicFX Voice",
  "short_name": "MicFX Voice",
  "description": "Live voice effects for your microphone: autotune, harmonies, reverb and more, in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "share_target": { "action": "share-target", "method": "POST", "enctype": "multipart/form-data", "params": { "files": [{ "name": "audio", "accept": ["audio/*", ".m4a", ".mp3", ".wav"] }] } },
  "shortcuts": [
    { "name": "New recording", "short_name": "Record", "description": "Start recording an idea", "url": "capture.html?record=1", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "My ideas", "short_name": "Ideas", "url": "capture.html#ideas", "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
